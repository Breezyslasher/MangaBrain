<?xml version="1.0" encoding="utf-8"?>
<!-- Install progress (3b): a 6dp track in --track with an accent fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="@color/track" /><corners android:radius="3dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="@color/accent" /><corners android:radius="3dp" /></shape></clip>
    </item>
</layer-list>
