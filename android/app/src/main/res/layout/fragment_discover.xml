<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- The medium as a dropdown, not a row of chips: seven media no longer
         fit a phone's width, and the last ones scrolled off where nobody saw
         them. The chevron is a separate view so it sits at the end of the
         field whatever the label's length. -->
    <!-- As wide as its longest label, not the screen: it is a picker, not
         a field to type in. A Spinner measures wrap_content against its
         items, so every medium fits without the field changing width. -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp">

        <Spinner
            android:id="@+id/mediumSpinner"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_field"
            android:contentDescription="@string/cd_medium"
            android:paddingStart="14dp"
            android:paddingEnd="40dp"
            android:popupBackground="@color/surface"
            android:spinnerMode="dropdown" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/mdi_chevron_down"
            app:tint="@color/muted"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:minHeight="48dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="16sp"
            android:autofillHints="" />

        <Button
            android:id="@+id/browseButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:text="@string/browse" />
    </LinearLayout>

    <!-- Searching by name finds a title you can already name; this finds
         one you can only describe. Separate box rather than a mode switch
         on the one above: they answer different questions, and a reader
         who knows the title should not have to describe it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/describeInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/describe_hint"
            android:imeOptions="actionSearch"
            android:inputType="textCapSentences"
            android:maxLines="2"
            android:minHeight="48dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="16sp"
            android:autofillHints="" />

        <Button
            android:id="@+id/describeButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:text="@string/find" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/muted"
        android:visibility="gone" />

    <!-- The only scroller on this screen. The seed card, related titles and
         match count ride along as a full-span header item (see
         DiscoverHeaderAdapter) instead of sitting in a ScrollView wrapped
         around this, which both broke scrolling and defeated recycling. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/resultsGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/forYouButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/for_you" />

        <Button
            android:id="@+id/surpriseButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:text="@string/surprise_me" />
    </LinearLayout>
</LinearLayout>
