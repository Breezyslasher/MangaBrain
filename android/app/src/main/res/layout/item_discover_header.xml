<?xml version="1.0" encoding="utf-8"?>
<!-- The seed card, its related titles and the match count, as a full-span
     item at the top of the result grid. These used to live in a ScrollView
     wrapped around the grid, which broke scrolling and inflated every
     result at once; as a header item they scroll with the results and the
     grid recycles normally. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- seedCard is the whole panel: the cover-and-title row, then the
         synopsis underneath it. The synopsis is full width rather than in
         the column beside the cover, where an 80dp-wide cover leaves a
         column too narrow for prose. -->
    <LinearLayout
        android:id="@+id/seedCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/panel"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/seedCover"
                android:layout_width="80dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:background="@color/card"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/seed"
                    android:textAllCaps="true"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/seedTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/seedMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/seedAddToMix"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="44dp"
                    android:paddingHorizontal="0dp"
                    android:text="@string/add_to_mix"
                    android:textColor="@color/accent" />
            </LinearLayout>
        </LinearLayout>

        <!-- Clamped, because a full AniList synopsis is long enough to push
             every result off the screen. The toggle expands it in place;
             both it and the text are hidden when the catalog has no
             description for the title, which is common for one-shots. -->
        <TextView
            android:id="@+id/seedDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="4"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/seedDescriptionToggle"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:paddingHorizontal="0dp"
            android:text="@string/read_more"
            android:textColor="@color/accent"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/relatedList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <TextView
        android:id="@+id/resultCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:textColor="@color/text"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
