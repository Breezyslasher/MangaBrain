<?xml version="1.0" encoding="utf-8"?>
<!-- A self-hosted server is often plain HTTP on a LAN address, which API 28+
     blocks by default. This used to permit cleartext for "10.0.0.0",
     "192.168.0.0" and "172.16.0.0", but a domain entry matches a hostname,
     never an address range: http://192.168.1.28:8009 was refused, and only
     HTTPS servers worked. Android has no way to allow a range, so plain
     HTTP is allowed, as other self-hosted clients do. The address is one
     the user typed for their own server; an internet-facing server should
     still be reached over HTTPS, as the Settings help says. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
