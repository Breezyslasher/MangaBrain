# Connection string used by the API and all pipeline scripts.
DATABASE_URL=postgresql://mangabrain:mangabrain@localhost:5432/mangabrain

# Sentence-transformers model used for synopsis embeddings. 384-dim and
# 768-dim models are ANN-indexed out of the box; another dimension needs an
# index pair added in db/schema.sql. Changing the model re-embeds the
# catalog as a migration (pipeline.embed), old rows serve until it is done.
EMBED_MODEL=avsolatorio/GIST-Embedding-v0

# Optional on-disk HTTP response cache for pipeline scripts (dev convenience).
# Off by default; set to a directory (e.g. .http_cache) to enable. Cached
# responses expire after 24 hours.
HTTP_CACHE_DIR=

# Password for the bundled Postgres. docker-compose interpolates this into
# both the db container and the service connection strings; the default is
# "mangabrain". The db port is bound to 127.0.0.1 only.
# MANGABRAIN_DB_PASSWORD=change-me

# Minimum seconds between requests to each upstream API.
ANILIST_MIN_INTERVAL=2.0
JIKAN_MIN_INTERVAL=0.5

# How often the worker container runs the incremental sync + embed pass.
SYNC_INTERVAL_HOURS=24

# CPU threads torch may use while embedding. 0 (default) = all cores minus
# one, keeping a small host responsive; set an exact count to change it.
# The worker container also runs at a quarter CPU weight (cpu_shares), so
# under contention other apps win regardless.
MANGABRAIN_EMBED_THREADS=0

# Optional catalog snapshot the worker seeds an empty database from (see
# pipeline.restore). Leave empty to sync from AniList directly.
SEED_SNAPSHOT_URL=

# Official MyAnimeList API client id, needed for MAL list exclusion
# (POST /mal/{username}/refresh). Free and instant from
# https://myanimelist.net/apiconfig - create an app, copy the Client ID.
# A public list needs only this header; there is no OAuth user flow. Jikan's
# user-list endpoints were discontinued in 2022, so this is the only route.
MANGABRAIN_MAL_CLIENT_ID=

# Optional self-hosted Yamtrack instance for list exclusion. The token is on
# the Yamtrack profile page; exclude results with exclude_list=yamtrack after
# POST /yamtrack/refresh.
YAMTRACK_URL=
YAMTRACK_TOKEN=
# Hardcover book tracker: a personal access token from hardcover.app >
# Settings > API. Optional; the app's Settings tab can store one instead.
HARDCOVER_TOKEN=
# Films and TV (pipeline/sync_tmdb.py): a free TMDB API key, a v3 key or a
# v4 read access token from themoviedb.org > Settings > API. Optional; the
# app's Settings > Server can store one instead. This install fetches the
# catalogue itself - TMDB's terms rule out publishing it as a dataset.
TMDB_API_KEY=

# Public-exposure hardening (only needed when the app is reachable from the
# internet, e.g. through a Cloudflare Tunnel). AUTH_TOKEN locks every API
# request behind Authorization: Bearer <token> - the web app asks for it once
# and remembers it. RATE_LIMIT_PER_MINUTE caps API requests per client IP.
MANGABRAIN_AUTH_TOKEN=
MANGABRAIN_RATE_LIMIT=0
