# Connection string used by the API and all pipeline scripts.
DATABASE_URL=postgresql://mangabrain:mangabrain@localhost:5432/mangabrain

# Sentence-transformers model used for synopsis embeddings. Must be 384-dim
# to fit the vector column. Previous default: sentence-transformers/all-MiniLM-L6-v2.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Optional on-disk HTTP response cache for pipeline scripts (dev convenience).
# Off by default; set to a directory (e.g. .http_cache) to enable. Cached
# responses expire after 24 hours.
HTTP_CACHE_DIR=

# Password for the bundled Postgres. docker-compose interpolates this into
# both the db container and the service connection strings; the default is
# "mangabrain". The db port is bound to 127.0.0.1 only.
# MANGABRAIN_DB_PASSWORD=change-me

# Minimum seconds between requests to each upstream API.
ANILIST_MIN_INTERVAL=2.0
JIKAN_MIN_INTERVAL=0.5

# How often the worker container runs the incremental sync + embed pass.
SYNC_INTERVAL_HOURS=24

# Optional catalog snapshot the worker seeds an empty database from (see
# pipeline.restore). Leave empty to sync from AniList directly.
SEED_SNAPSHOT_URL=

# Optional self-hosted Yamtrack instance for list exclusion. The token is on
# the Yamtrack profile page; exclude results with exclude_list=yamtrack after
# POST /yamtrack/refresh.
YAMTRACK_URL=
YAMTRACK_TOKEN=
